# generated by tests/test-benchmark-runner.js and tests/test-runner-receipt.js
tests/minicorpus.jsonl
tests/benchmark-report.json
tests/benchmark-report.html
tests/benchmark-summary.json
tests/receipt-runner-*.json

# Corpus v0.7 canonical dataset: 120MB derived from the immutable v0.6 archive
# by scripts/build-corpus-v07.js. The checksum manifest, schema, stats,
# exclusions and record-level change inventory are committed; the bytes are
# rebuilt on demand and verified against public/corpus/v0.7/SHA256SUMS.txt.
public/corpus/v0.7/all.jsonl

# Rebuilt locally from v0.7. The separately committed gzip is the complete
# v0.8 website download and is checked against the generated plain JSONL.
public/corpus/v0.8/all.jsonl

# Staged Zenodo upload packages: large generated payloads, rebuilt on demand
# with `node scripts/build-corpus-deposit.js <version>`.
dist/

# Public-domain corpora fetched on demand by scripts/build-research-language-profiles.js.
# Only the derived n-gram counts are committed; the source transcriptions are not.
tmp/
