{
  "name": "cipher-museum",
  "version": "1.0.0",
  "description": "The Cipher Museum is part digital exhibit, part cipher playground, and part codebreaking classroom exploring 3,900+ years of encryption, cryptanalysis, and hidden history.",
  "private": true,
  "scripts": {
    "test": "node tests/run-all.js",
    "test:engines": "node tests/test-all-engines.js",
    "test:deep": "node tests/test-deep-ciphers.js",
    "test:comprehensive": "node tests/test-comprehensive.js",
    "test:demos": "node tests/test-demo-pages.js",
    "test:playground": "node tests/test-playground.js",
    "test:a11y": "node tests/test-accessibility.js",
    "test:mobile": "node tests/test-mobile.js",
    "test:structural": "node tests/test-structural.js",
    "test:links": "node tests/test-local-links.js",
    "validate:corpus": "node scripts/validate-corpus-v0.2.js public/corpus/all.jsonl",
    "build:search-index": "node scripts/build-search-index.js",
    "build:js": "node scripts/build-min.js",
    "lint:html": "htmlhint \"ciphers/*.html\" \"halls/*.html\" \"*.html\" \"lab/*.html\" \"tours/*.html\" \"community/*.html\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/cipher-museum.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "jsdom": "^24.0.0",
    "terser": "^5.48.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1"
  }
}
